# ── 서버 ─────────────────────────────────
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────────
DATABASE_URL=postgres://oljim:oljim@localhost:5432/oljim
PGSSL=false

# ── Redis ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── 세션 / JWT ───────────────────────────
SESSION_SECRET=replace_me_with_long_random_string
JWT_SECRET=replace_me_with_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── 카카오 OAuth ─────────────────────────
# 카카오 디벨로퍼스에서 발급
# https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:4000/v1/auth/kakao/callback
# 카카오 키가 없어도 동작하도록 폴백 로그인 사용
ENABLE_KAKAO_FALLBACK=true

# ── 알림 (옵션) ──────────────────────────
COOLSMS_API_KEY=
COOLSMS_API_SECRET=
KAKAO_BIZ_SENDER_KEY=
